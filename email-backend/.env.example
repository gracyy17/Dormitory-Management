PORT=5001

# Comma-separated allowed origins for browser requests
# Example: http://localhost:5173,https://dorm-27fe2-eb047.web.app
ALLOWED_ORIGINS=http://localhost:5173

# Scheduler
ENABLE_INTERNAL_CRON=true
CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Manila
CRON_SECRET=change-me
REMINDER_LEAD_DAYS=7

# SMTP (Gmail SMTP example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MZ Dormitory

# Reminder template metadata
TENANT_PORTAL_URL=https://dorm-27fe2-eb047.web.app/tenant/login
CONTACT_EMAIL=
CONTACT_PHONE=
DORM_NAME=MZ Dormitory

# Firebase service account JSON in one line (recommended for deployments)
# Example: {"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative: local path to service account json file
# Example (Windows): C:/Users/YourName/Downloads/service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: When true, /api/reminders/run requires Firebase admin role.
# Caller must send Authorization: Bearer <Firebase ID token>
REQUIRE_ADMIN_AUTH=true
