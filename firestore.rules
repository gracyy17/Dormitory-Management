rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'tenant'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'email',
          'role',
          'fullName',
          'phone',
          'emergencyContact',
          'homeAddress',
          'profileImageDataUrl',
          'profileImageUrl',
          'mustChangePassword',
          'notifyEmail',
          'roomNo',
          'roomBed',
          'createdAt',
          'createdBy',
          'leaseStart',
          'leaseEnd'
        ])
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'profileImageDataUrl',
          'profileImageUrl',
          'fullName',
          'phone',
          'emergencyContact',
          'homeAddress',
          'mustChangePassword'
        ])
        && (
          !request.resource.data.diff(resource.data).changedKeys().hasAny(['mustChangePassword'])
          || request.resource.data.mustChangePassword == false
        )
      );
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if isSignedIn() && request.resource.data.tenantUid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.tenantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /dues/{dueId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && resource.data.tenantUid == request.auth.uid);
    }

    match /maintenanceRequests/{requestId} {
      allow create: if isSignedIn() && request.resource.data.tenantUid == request.auth.uid;
      allow read: if isAdmin() || (isSignedIn() && resource.data.tenantUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
